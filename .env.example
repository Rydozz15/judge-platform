# Copia este archivo como `.env` y ajusta los valores. `.env` NO se versiona.

# Puerto/host del servidor
EVAL_HOST=0.0.0.0
EVAL_PORT=8080

# Ruta de la base SQLite (por defecto: ./data/evaluation.db)
# EVAL_DB_PATH=./data/evaluation.db

# Contraseña inicial del usuario 'admin' (solo se aplica al crear una base nueva).
# ¡Cámbiala antes de exponer la plataforma fuera de tu equipo!
EVAL_ADMIN_PASSWORD=cambia-esta-clave

# Intérprete Python a usar para crear el entorno virtual (opcional)
# PYTHON=python3.12
